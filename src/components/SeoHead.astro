---
import {
  serializeStructuredData,
  type HreflangLink,
  type StructuredData,
} from '../lib/seo';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  alternates: HreflangLink[];
  image?: string;
  type?: 'website' | 'article';
  structuredData?: StructuredData;
}

const {
  title,
  description,
  canonicalUrl,
  alternates,
  image,
  type = 'website',
  structuredData,
} = Astro.props;
const jsonLd = structuredData
  ? serializeStructuredData(structuredData)
  : undefined;
const absoluteImage = image ? new URL(image, SITE.url).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
  ))
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
<meta
  name="twitter:card"
  content={absoluteImage ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
