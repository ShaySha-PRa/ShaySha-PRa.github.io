---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="fallback-notice" data-translation-fallback role="note">
  {
    locale === 'en'
      ? 'English version in preparation · 中文内容暂代'
      : '英文版准备中 · English version in preparation'
  }
</aside>

<style>
  .fallback-notice {
    margin-block: 1rem;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--vermilion);
    color: var(--muted);
    background: color-mix(in srgb, var(--sand) 25%, transparent);
    font-size: 0.95rem;
  }
</style>
