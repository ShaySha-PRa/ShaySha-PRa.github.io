---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="home-hero shell" data-section="intro">
  <div class="home-hero__copy">
    <p class="home-kicker">
      {locale === 'zh' ? '个人空间 / 01' : 'Personal space / 01'}
    </p>
    <h1 lang="en">Building useful systems, collecting curious ideas.</h1>
    <p class="home-hero__lede" lang={locale === 'zh' ? 'zh-CN' : 'en'}>
      {
        locale === 'zh'
          ? '记录软件项目、技术文章，以及值得慢慢观察的影像与生活片段。'
          : 'A working archive of software projects, technical writing, and images or life notes worth keeping.'
      }
    </p>
  </div>
</section>
