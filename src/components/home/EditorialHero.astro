---
import type { Locale } from '../../lib/i18n';
import { SITE } from '../../config/site';
import { localizedPath } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projectLabel = locale === 'zh' ? '查看代表项目' : 'View featured project';
const resumeLabel = locale === 'zh' ? '查看简历' : 'View résumé';
const contactLabel = locale === 'zh' ? '联系我' : 'Contact me';
---

<section class="home-hero shell" data-section="intro">
  <div class="home-hero__copy">
    <p class="home-kicker">AI Application Engineer / 01</p>
    <h1>{SITE.positioning[locale]}</h1>
    <p class="home-hero__lede" lang={locale === 'zh' ? 'zh-CN' : 'en'}>
      {SITE.valueProposition[locale]}
    </p>
    <nav
      class="home-hero__actions"
      aria-label={locale === 'zh' ? '首页快捷入口' : 'Homepage shortcuts'}
    >
      <a
        class="home-hero__action home-hero__action--primary"
        href="#featured-project"
      >
        {projectLabel}
      </a>
      <a class="home-hero__action" href={localizedPath(locale, 'resume')}>
        {resumeLabel}
      </a>
      <a
        class="home-hero__action home-hero__action--text"
        href={`${localizedPath(locale, 'about')}#contact`}
      >
        {contactLabel}
      </a>
    </nav>
    <p class="home-hero__signature" lang="en">{SITE.signature}</p>
    <ul
      class="home-hero__proof"
      aria-label={locale === 'zh' ? '核心能力' : 'Core capabilities'}
    >
      {SITE.proof[locale].map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
