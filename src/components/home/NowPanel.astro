---
import { SITE } from '../../config/site';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projectPath = `${locale === 'en' ? '/en' : ''}/projects/my-company-brain/`;
---

<section class="home-now shell" data-section="now">
  <p class="home-kicker">
    {locale === 'zh' ? '最近在做什么 / 03' : 'Now / 03'}
  </p>
  <h2>{locale === 'zh' ? '最近在做什么' : 'What I am doing now'}</h2>
  <div class="home-now__content">
    <p class="home-now__date">{SITE.now.date}</p>
    <p>{SITE.now[locale]}</p>
    <a class="home-text-link" href={projectPath}>
      {locale === 'zh' ? '查看项目进展 →' : 'View project progress →'}
    </a>
  </div>
  <p class="home-now__note">
    {
      locale === 'zh'
        ? '这是一个简短的、会随工作重心变化的现场记录。'
        : 'A short field note that changes with the work in progress.'
    }
  </p>
</section>
