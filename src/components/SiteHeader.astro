---
import { SITE } from '../config/site';
import LocaleSwitch from './LocaleSwitch.astro';
import type { Locale, Section } from '../lib/i18n';
import { localizedPath } from '../lib/i18n';

interface Props {
  locale: Locale;
  translationPath?: string;
}

const { locale, translationPath } = Astro.props;
const labels = SITE.nav[locale];
const routedLinks: Array<{ key: keyof typeof labels; section: Section }> = [
  { key: 'home', section: 'home' },
  { key: 'projects', section: 'projects' },
  { key: 'writing', section: 'writing' },
  { key: 'journal', section: 'journal' },
  { key: 'about', section: 'about' },
  { key: 'resume', section: 'resume' },
];

const currentPath = Astro.url.pathname;
const isCurrentSection = (section: Section) => {
  const target = localizedPath(locale, section);
  if (section === 'home') return currentPath === target;
  return currentPath.startsWith(target);
};

const linkItems = routedLinks.map(({ key, section }) => ({
  label: labels[key],
  href: localizedPath(locale, section),
  current: isCurrentSection(section),
}));
linkItems.push({
  label: labels.contact,
  href: `${localizedPath(locale, 'about')}#contact`,
  current: false,
});
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-brand" href={localizedPath(locale, 'home')}>{SITE.name}</a>

    <nav
      class="primary-nav"
      aria-label={locale === 'zh' ? '主导航' : 'Primary'}
    >
      <ul>
        {
          linkItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <LocaleSwitch locale={locale} translationPath={translationPath} />
        </li>
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary>{locale === 'zh' ? '菜单' : 'Menu'}</summary>
      <div class="mobile-nav__panel">
        <nav aria-label={locale === 'zh' ? '移动端导航' : 'Mobile navigation'}>
          <ul>
            {
              linkItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <LocaleSwitch locale={locale} translationPath={translationPath} />
            </li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  const mobileNav = document.querySelector(
    'details.mobile-nav',
  ) as HTMLDetailsElement | null;
  const summary = mobileNav?.querySelector('summary') as HTMLElement | null;
  const panel = mobileNav?.querySelector(
    '.mobile-nav__panel',
  ) as HTMLElement | null;
  const background = Array.from(document.body.children).filter(
    (element) => !element.matches('.site-header'),
  );

  if (mobileNav && summary && panel) {
    const focusableSelector =
      'a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])';

    const focusable = () =>
      Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector)).filter(
        (element) =>
          !element.hasAttribute('disabled') &&
          element.getAttribute('aria-hidden') !== 'true',
      );

    const setBackgroundInert = (inert: boolean) => {
      background.forEach((element) => {
        if (inert) {
          element.setAttribute('inert', '');
        } else {
          element.removeAttribute('inert');
        }
      });
    };

    mobileNav.addEventListener('toggle', () => {
      if (mobileNav.open) {
        setBackgroundInert(true);
        focusable()[0]?.focus();
      } else {
        setBackgroundInert(false);
        summary.focus();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!mobileNav.open) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        mobileNav.open = false;
        return;
      }

      if (event.key !== 'Tab') return;
      const items = focusable();
      if (items.length === 0) {
        event.preventDefault();
        summary.focus();
        return;
      }

      if (!panel.contains(document.activeElement)) {
        event.preventDefault();
        items[0].focus();
        return;
      }

      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
