---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/prose.css';

const entries = await getCollection('resume', ({ data }) => !data.draft);
const resume = (entries
  .filter((entry) => entry.data.locale === 'en')
  .sort((a, b) => a.data.order - b.data.order)[0] ??
  entries
    .filter((entry) => entry.data.locale === 'zh')
    .sort((a, b) => a.data.order - b.data.order)[0]) as
  CollectionEntry<'resume'> | undefined;
const fallback = resume?.data.locale === 'zh';
const rendered = resume ? await render(resume) : undefined;
const Content = rendered?.Content;
const pdfPath = resume?.data.pdfPath;
const hasPdf =
  pdfPath === '/resume/junshu-sha-resume.pdf' &&
  existsSync(
    fileURLToPath(
      new URL('../../../public/resume/junshu-sha-resume.pdf', import.meta.url),
    ),
  );
---

<BaseLayout
  locale="en"
  title="Résumé · Junshu Sha"
  description="Junshu Sha's web résumé."
  canonicalPath="/en/resume/"
  translationPath="/resume/"
  fallback={fallback}
>
  <article class="resume-page shell">
    <header class="resume-page__header">
      <p class="resume-page__eyebrow">Résumé</p>
      <h1>Résumé</h1>
      {
        resume ? (
          <p class="resume-page__summary">{resume.data.summary}</p>
        ) : (
          <p class="resume-page__empty" role="status">
            Résumé is being prepared and will be published after confirmation.
          </p>
        )
      }
      {
        hasPdf && (
          <p class="resume-page__download">
            <a href={pdfPath}>Download résumé PDF ↗</a>
          </p>
        )
      }
    </header>
    {
      Content && (
        <div class="resume-page__body prose">
          <Content />
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .resume-page {
    padding-block: 3rem 1rem;
  }

  .resume-page__header {
    max-width: 46rem;
  }

  .resume-page__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--vermilion);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resume-page h1 {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 7rem);
  }

  .resume-page__summary,
  .resume-page__empty {
    max-width: 42rem;
    margin-block: 1.25rem 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .resume-page__empty {
    margin-block: 2rem 0;
    padding: 1.5rem 1.25rem;
    border-block: 1px solid var(--sand);
  }

  .resume-page__download {
    margin-top: 1.5rem;
  }

  .resume-page__body {
    margin-top: 4rem;
  }

  @media (max-width: 48rem) {
    .resume-page {
      padding-block-start: 2rem;
    }
  }
</style>
