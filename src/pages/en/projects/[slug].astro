---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { getLocalizedCollection } from '../../../lib/content';
import { projectTranslationPath } from '../../../lib/project-routes';

type ProjectSelection = Awaited<
  ReturnType<typeof getLocalizedCollection<'projects'>>
>[number];

export async function getStaticPaths() {
  const projects = await getLocalizedCollection('projects', 'en');
  return projects.map((selection) => ({
    params: { slug: selection.entry.slug },
    props: selection,
  }));
}

const selection = Astro.props as ProjectSelection;
const projects = await getLocalizedCollection('projects', 'en');
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projectRecords = allProjects.map(({ data }) => data);
const currentIndex = projects.findIndex(
  (item) => item.entry.id === selection.entry.id,
);
const previous =
  currentIndex > 0 ? projects[currentIndex - 1].entry.entry : undefined;
const next =
  currentIndex >= 0 && currentIndex < projects.length - 1
    ? projects[currentIndex + 1].entry.entry
    : undefined;
const translationPath = projectTranslationPath(
  'en',
  selection.entry,
  projectRecords,
);
---

<ProjectLayout
  locale="en"
  project={selection.entry.entry as CollectionEntry<'projects'>}
  previous={previous}
  next={next}
  translationPath={translationPath}
  fallback={selection.isFallback}
/>
