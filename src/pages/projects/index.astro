---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';
import { getLocalizedCollection } from '../../lib/content';

const projects = await getLocalizedCollection('projects', 'zh');
---

<BaseLayout
  locale="zh"
  title="项目 · Junshu Sha"
  description="Junshu Sha 的六个个人开发项目与案例记录。"
  canonicalPath="/projects/"
  translationPath="/en/projects/"
>
  <section class="shell projects-index">
    <header class="projects-index__header">
      <p class="projects-index__eyebrow">Selected work / 01—06</p>
      <h1>项目</h1>
      <p>六个个人开发项目，记录问题、设计、工程取舍与仓库中的验证证据。</p>
    </header>
    <div class="projects-grid">
      {
        projects.map((selection) => (
          <ProjectCard
            project={selection.entry}
            requestedLocale={selection.requestedLocale}
            fallback={selection.isFallback}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .projects-index {
    padding-block: 3rem 1rem;
  }

  .projects-index__header {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .projects-index__eyebrow {
    margin: 0 0 1rem;
    color: var(--vermilion);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .projects-index h1 {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 7rem);
  }

  .projects-index__header > p:last-child {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .projects-grid :global(.project-card:first-child) {
    grid-column: span 2;
  }

  @media (max-width: 48rem) {
    .projects-index {
      padding-block-start: 2rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid :global(.project-card:first-child) {
      grid-column: auto;
    }
  }
</style>
