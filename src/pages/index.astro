---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/home/EditorialHero.astro';
import FeaturedProject from '../components/home/FeaturedProject.astro';
import NowPanel from '../components/home/NowPanel.astro';
import ProjectSelection from '../components/home/ProjectSelection.astro';
import LatestWriting from '../components/home/LatestWriting.astro';
import LatestJournal from '../components/home/LatestJournal.astro';
import { SITE } from '../config/site';
import { getLocalizedCollection } from '../lib/content';

const projects = await getLocalizedCollection('projects', 'zh');
const articles = await getLocalizedCollection('articles', 'zh');
const journal = await getLocalizedCollection('journal', 'zh');
const featured = projects.find(({ entry }) => entry.featured) ?? projects[0];
const selected = projects
  .filter((selection) => selection !== featured)
  .slice(0, 5);
---

<BaseLayout
  locale="zh"
  title="Junshu Sha · 个人空间"
  description={SITE.descriptions.zh}
  canonicalPath="/"
  translationPath="/en/"
  image={featured?.entry.cover.src}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
    sameAs: [SITE.github],
  }}
>
  <div class="home-page">
    <EditorialHero locale="zh" />
    <div class="home-featured-row shell">
      {featured && <FeaturedProject selection={featured} locale="zh" />}
      <NowPanel locale="zh" />
    </div>
    <ProjectSelection projects={selected} locale="zh" />
    <div
      class:list={[
        'home-closing-row shell',
        { 'home-closing-row--single': articles.length === 0 },
      ]}
    >
      {articles.length > 0 && <LatestWriting articles={articles} locale="zh" />}
      <LatestJournal entries={journal} locale="zh" />
    </div>
  </div>
</BaseLayout>
