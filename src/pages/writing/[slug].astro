---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getNativeLocalizedCollection } from '../../lib/content';
import { articleTranslationPath } from '../../lib/article-routes';

type ArticleSelection = Awaited<
  ReturnType<typeof getNativeLocalizedCollection<'articles'>>
>[number];

export async function getStaticPaths() {
  const articles = await getNativeLocalizedCollection('articles', 'zh');
  return articles.map((selection) => ({
    params: { slug: selection.entry.slug },
    props: selection,
  }));
}

const selection = Astro.props as ArticleSelection;
const articles = await getNativeLocalizedCollection('articles', 'zh');
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const related = articles
  .filter((item) => item.entry.id !== selection.entry.id)
  .filter((item) =>
    item.entry.tags.some((tag) => selection.entry.tags.includes(tag)),
  )
  .slice(0, 3);

const article = selection.entry.entry as CollectionEntry<'articles'>;
const translationPath = articleTranslationPath(
  'zh',
  selection.entry,
  allArticles.map(({ data }) => data),
);
---

<ArticleLayout
  locale="zh"
  article={article}
  related={related}
  translationPath={translationPath}
  fallback={selection.isFallback}
/>
