---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="zh"
  title="页面未找到 · Page not found"
  description="页面未找到。Page not found."
  canonicalPath="/404.html"
  translationPath="/404.html"
>
  <section class="not-found shell" aria-labelledby="not-found-title">
    <p class="not-found__eyebrow">404</p>
    <h1 id="not-found-title">页面未找到</h1>
    <h2 lang="en">Page not found</h2>
    <p class="not-found__summary">
      你要找的页面不存在，或已移动到别处。The page you are looking for does not
      exist or has moved.
    </p>
    <nav aria-label="页面导航 / Page navigation">
      <ul class="not-found__links">
        <li><a href="/">返回首页 · Home</a></li>
        <li><a href="/projects/">查看项目 · Projects</a></li>
        <li><a href="/writing/">阅读文章 · Writing</a></li>
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vw, 9rem) 1rem;
  }

  .not-found__eyebrow {
    margin: 0 0 1rem;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .not-found h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 7rem);
  }

  .not-found h2 {
    margin: 1rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .not-found__summary {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .not-found nav {
    margin-top: 2.5rem;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
